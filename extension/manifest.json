{
  "manifest_version": 3,
  "name": "Wishlist Notifier",
  "version": "1.0.0",
  "description": "Send subtle hints about products you're interested in",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.microcenter.com/*",
    "https://store.steampowered.com/*",
    "https://www.newegg.com/*",
    "https://www.bestbuy.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.microcenter.com/*",
        "https://store.steampowered.com/*",
        "https://www.newegg.com/*",
        "https://www.bestbuy.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
